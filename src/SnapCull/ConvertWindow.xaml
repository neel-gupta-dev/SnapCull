<Window x:Class="SnapCull.ConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Convert photos" Icon="SnapCull.ico" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource PanelBrush}">
  <StackPanel Margin="22">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Which photos" FontWeight="SemiBold" VerticalAlignment="Center" />
      <ComboBox Grid.Row="0" Grid.Column="1" x:Name="WhichCombo" SelectionChanged="Inputs_Changed" />

      <TextBlock Grid.Row="1" Text="Format" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,14,0,0" />
      <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FormatCombo" SelectionChanged="Inputs_Changed" Margin="0,14,0,0" />

      <TextBlock Grid.Row="2" x:Name="QualityLabel" Text="Quality" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,12,0,0" />
      <DockPanel Grid.Row="2" Grid.Column="1" x:Name="QualityPanel" Margin="0,12,0,0">
        <TextBlock DockPanel.Dock="Right" x:Name="QualityValue" Width="36" TextAlignment="Right" VerticalAlignment="Center" />
        <Slider x:Name="QualitySlider" Minimum="40" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="90"
                ValueChanged="QualitySlider_ValueChanged" VerticalAlignment="Center" />
      </DockPanel>

      <CheckBox Grid.Row="3" Grid.Column="1" x:Name="Tiff16Check" Margin="0,10,0,0" Click="Inputs_Changed"
                Content="16 bits per colour (for heavy editing; renders RAW files in full)" />

      <TextBlock Grid.Row="4" Text="Size" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,14,0,0" />
      <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
        <ComboBox x:Name="ResizeCombo" Width="200" SelectionChanged="Inputs_Changed">
          <ComboBoxItem Content="Original size" />
          <ComboBoxItem Content="Long edge (pixels)" />
          <ComboBoxItem Content="Percentage" />
        </ComboBox>
        <TextBox x:Name="ResizeBox" Width="90" Margin="10,0,6,0" TextChanged="Inputs_Changed" />
        <TextBlock x:Name="ResizeUnit" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
      </StackPanel>

      <TextBlock Grid.Row="5" Text="RAW files" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,14,0,0" />
      <ComboBox Grid.Row="5" Grid.Column="1" x:Name="RawCombo" SelectionChanged="Inputs_Changed" Margin="0,14,0,0">
        <ComboBoxItem Content="Automatic (recommended)" />
        <ComboBoxItem Content="Camera preview: fastest, camera colours" />
        <ComboBoxItem Content="Full RAW render: best detail, slower" />
      </ComboBox>

      <TextBlock Grid.Row="6" Text="Camera info" FontWeight="SemiBold" Margin="0,16,0,0" />
      <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,16,0,0">
        <CheckBox x:Name="KeepMetadataCheck" IsChecked="True" Click="Inputs_Changed"
                  Content="Keep camera, lens, settings and date" />
        <CheckBox x:Name="RemoveGpsCheck" Margin="0,6,0,0" Click="Inputs_Changed"
                  Content="Remove GPS location (good for sharing online)" />
      </StackPanel>

      <TextBlock Grid.Row="7" Text="File names" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,16,0,0" />
      <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,16,0,0">
        <TextBox x:Name="PatternBox" TextChanged="Inputs_Changed" />
        <TextBlock x:Name="PatternHelp" Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
      </StackPanel>

      <TextBlock Grid.Row="8" Text="Save to" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,14,0,0" />
      <DockPanel Grid.Row="8" Grid.Column="1" Margin="0,14,0,0">
        <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" />
        <TextBox x:Name="DestinationBox" TextChanged="Inputs_Changed" />
      </DockPanel>
    </Grid>

    <TextBlock x:Name="SummaryText" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="OkButton" Content="Convert" IsDefault="True" MinWidth="96" Click="Ok_Click" />
      <Button Content="Cancel" IsCancel="True" MinWidth="96" Margin="8,0,0,0" />
    </StackPanel>
  </StackPanel>
</Window>
