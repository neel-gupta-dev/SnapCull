<UserControl x:Class="SnapCull.PhotoGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SnapCull"
             x:Name="Root" Background="{StaticResource ViewerBrush}" Focusable="False">
  <Grid>
    <!-- One list item per row of photos: only rows on screen are drawn, so thousands of photos stay fast. -->
    <ListBox x:Name="Rows" Background="Transparent" BorderThickness="0" Focusable="False" Padding="8,8,8,8"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.CanContentScroll="True"
             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.ScrollChanged="Rows_ScrollChanged"
             SizeChanged="Rows_SizeChanged" PreviewMouseWheel="Rows_PreviewMouseWheel">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Focusable" Value="False" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <ContentPresenter />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type local:GridRow}">
          <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:PhotoItem}">
                <Border Width="{Binding CellSize, ElementName=Root}" Margin="4" CornerRadius="5" BorderThickness="2"
                        Background="#1E1E1E" ToolTip="{Binding DisplayName}" Cursor="Hand"
                        MouseLeftButtonDown="Cell_MouseDown">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderBrush" Value="Transparent" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGridSelected}" Value="True">
                          <Setter Property="BorderBrush" Value="#6E9BD8" />
                          <Setter Property="Background" Value="#24324A" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsGridCurrent}" Value="True">
                          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="{Binding ImageHeight, ElementName=Root}" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsRejected}" Value="True">
                            <Setter Property="Opacity" Value="0.4" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>

                    <Image Source="{Binding GridImage}" Stretch="Uniform" Margin="5" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="!" Foreground="#E54848" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Error, Converter={StaticResource VisibleIf}}" ToolTip="{Binding Error}" />
                    <Rectangle Height="4" VerticalAlignment="Top" Margin="5,3,5,0" RadiusX="2" RadiusY="2" Fill="{Binding LabelBrush}"
                               Visibility="{Binding HasLabel, Converter={StaticResource VisibleIf}}" />
                    <Border Margin="8,9,0,0" Padding="4,0" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{Binding BurstBadgeBrush}" ToolTip="{Binding BurstLine}"
                            Visibility="{Binding InBurst, Converter={StaticResource VisibleIf}}">
                      <TextBlock Text="{Binding BurstBadgeText}" Foreground="White" FontSize="10" FontWeight="Bold" />
                    </Border>
                    <Border Width="20" Height="20" CornerRadius="10" Margin="0,9,8,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="{Binding FlagBrush}" Visibility="{Binding FlagText, Converter={StaticResource VisibleIf}}">
                      <TextBlock Text="{Binding FlagGlyph}" Foreground="White" FontSize="12" FontWeight="Bold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Margin="8,0,0,8" Padding="5,0" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Background="{StaticResource OverlayBrush}" Visibility="{Binding StarsText, Converter={StaticResource VisibleIf}}">
                      <TextBlock Text="{Binding StarsText}" Foreground="{StaticResource StarBrush}" FontSize="12" />
                    </Border>
                    <Border Margin="0,0,8,8" Padding="4,0" CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="{Binding FocusBadgeBrush}" ToolTip="{Binding FocusLine}"
                            Visibility="{Binding FocusBadgeText, Converter={StaticResource VisibleIf}}">
                      <TextBlock Text="{Binding FocusBadgeText}" Foreground="White" FontSize="10" FontWeight="Bold" />
                    </Border>
                    <Rectangle Height="3" VerticalAlignment="Bottom" Margin="5,0,5,1" RadiusX="1.5" RadiusY="1.5" Fill="{Binding BurstBarBrush}"
                               Visibility="{Binding InBurst, Converter={StaticResource VisibleIf}}" />

                    <TextBlock Grid.Row="1" Text="{Binding DisplayName}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                               Margin="6,0,6,5" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                               Visibility="{Binding ShowNames, ElementName=Root, Converter={StaticResource VisibleIf}}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
