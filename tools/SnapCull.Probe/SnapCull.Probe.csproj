<Project Sdk="Microsoft.NET.Sdk">

  <!-- Command-line checker: runs SnapCull's preview extraction over a folder of camera files and reports what it finds. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SnapCull\SnapCull.csproj" />
  </ItemGroup>

</Project>
